	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:watch": "tsx watch src/server.ts",
		"inngest:dev": "inngest dev -u http://localhost:7000/api/inngest",
		"start": "node dist/src/server.js",
		"build": "tsc",
		"test": "echo \"Error: no test specified\" && exit 1",
		"db:generate": "bunx drizzle-kit generate",
		"db:push": "bunx drizzle-kit push",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:studio": "bunx drizzle-kit studio",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check": "bunx --bun @biomejs/biome check --write",
		"prepare": "husky"
	},
